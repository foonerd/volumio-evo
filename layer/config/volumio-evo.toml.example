# Volumio Evo config. Copy to /etc/volumio-evo/config.toml
# Install or first run: set music_root here or via VOLUMIO_EVO_MUSIC_ROOT
# (e.g. in systemd override). Service may run as a different user than volumio.
#
# Skip applying persisted network intent (`intent.toml`) at Evo startup. Default: apply after ~2s.
# Environment=VOLUMIO_EVO_SKIP_NETWORK_INTENT_APPLY=1
#
# Logging: error | warn | info | verbose | debug | trace
# Default filter when RUST_LOG is unset. Override: RUST_LOG (full directive) or VOLUMIO_EVO_LOG_LEVEL.
# info = discrete events (not per-second/poll spam); warn = quieter journal; verbose/debug for diagnosis.
# Journal: every line starts with "[EVO] "; see docs/OBSERVABILITY.md
log_level = "info"

bind = "0.0.0.0:3000"
# Primary Wi‑Fi interface for NM (`nmcli dev wifi list ifname …`) and default when intent.toml omits wifi.ifname.
# If omitted, Evo picks the first NM `wifi` device, preferring one that is not `unavailable` (handy with USB + SoC radios).
# Raspberry Pi 3/3+ with USB dongle: internal wlan0 vs USB wlan1 — set explicitly when both exist.
# Override: Environment=VOLUMIO_EVO_WIFI_IFACE=wlan1 (wins over this file).
# wifi_iface = "wlan1"
plugin_dir = "/usr/share/volumio-evo/plugins"
mpd_host = "127.0.0.1"
mpd_port = 6600

# Album art cache and personal uploads (folder, metadata, web, personal). Override: VOLUMIO_EVO_ALBUMART_ROOT
albumart_root = "/var/lib/volumio-evo/albumart"

# Path to exiftool for embedded art extraction (?metadata=true). Override: VOLUMIO_EVO_EXIFTOOL_PATH
# exiftool_path = "/usr/bin/exiftool"

# Optional: API keys for online album-art providers (for large libraries, avoids rate limits).
# Env overrides: VOLUMIO_EVO_LASTFM_API_KEY, VOLUMIO_EVO_MUSICBRAINZ_USER_AGENT
# [albumart_providers]
# lastfm_api_key = "your-lastfm-api-key"
# musicbrainz_user_agent = "VolumioEvo/1.0 (https://volumio.org)"

[music_sources]
# Base path; under it: INTERNAL, USB, NAS, SMB (stock Volumio names). MPD music_directory must match.
# Override at install: Environment=VOLUMIO_EVO_MUSIC_ROOT=/var/lib/volumio-evo/music
music_root = "/var/lib/volumio-evo/music"

# Stock Volumio UI layout names (see volumio3-backend volumioUisList.json).
# Evo records this for API/getUiSettings; nginx must serve the matching built dist.
# Override: Environment=VOLUMIO_EVO_ACTIVE_LAYOUT=classic
[ui]
active_layout = "contemporary"

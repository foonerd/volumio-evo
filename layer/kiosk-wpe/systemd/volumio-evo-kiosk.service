# Volumio Evo Kiosk session. User= is provided by a drop-in written by
# layer/kiosk-wpe/install.sh (/etc/systemd/system/volumio-evo-kiosk.service.d/10-user.conf).
#
# Design note (why the static TTYPath below):
# An earlier iteration attempted to discover the VT dynamically in ExecStartPre
# (preflight) and hand it to the unit via EnvironmentFile=-/run/.../preflight.env.
# That pattern is structurally broken: systemd reads EnvironmentFile at unit
# activation, BEFORE ExecStartPre runs, so TTYPath was never populated for the
# same invocation and pam_systemd reported "VT number out of range". Current
# design: TTYPath is static (/dev/tty1 - the first VT on every Linux host and
# the same slot a desktop display manager claims). RuntimeDirectory= manages
# /run/volumio-evo-kiosk with correct ownership. Preflight now only probes DRM.
#
# Browser: custom GTK4 + webkit2gtk 6.0 shell at /usr/local/bin/volumio-evo-kiosk-browser.
# See the layer README and docs/KIOSK.md for why WPE / cog was abandoned
# (WPE 2.48.3 does not deliver pointer button events to the DOM on Pi
# hardware) and why we use xdg_toplevel.set_maximized() rather than
# set_fullscreen() (squeekboard LAYER_TOP is covered by the wlroots
# "fullscreen" layer).
#
# This unit is NEVER enabled by install.sh. The backend toggle drives
# start/stop (crates/core/src/kiosk.rs + Settings -> System -> Kiosk).

[Unit]
Description=Volumio Evo Kiosk
Documentation=file:/usr/share/volumio-evo/repo/docs/KIOSK.md
After=network-online.target systemd-user-sessions.service volumio-evo.service
Wants=network-online.target volumio-evo.service
# When the kiosk runs it owns /dev/tty1. getty@tty1 stands down the same way
# it stands down when a display manager (gdm, sddm, lightdm) runs on a
# desktop Debian install. Stopping the kiosk lets getty@tty1 come back on
# its own.
Conflicts=getty@tty1.service
ConditionPathExistsGlob=/dev/dri/card*

[Service]
Type=simple
PAMName=login
# Static VT assignment. tty1 is the first console VT on every Linux system
# and the slot used by graphical sessions on minimal / Lite Debian targets.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# Managed by systemd: creates /run/volumio-evo-kiosk at unit start owned
# by User= from the 10-user.conf drop-in, cleans up at unit stop.
RuntimeDirectory=volumio-evo-kiosk
Environment=XDG_SESSION_TYPE=wayland
Environment=GDK_BACKEND=wayland
Environment=WLR_LIBINPUT_NO_DEVICES=0
ExecStartPre=/usr/local/bin/volumio-evo-kiosk-preflight
ExecStart=/usr/local/bin/volumio-evo-kiosk-launch
Restart=always
RestartSec=2
# Do not put this unit on logind seat0 exclusively; logind + PAMName=login
# creates the seat. Extra seat claims here just confuse labwc.

[Install]
WantedBy=multi-user.target

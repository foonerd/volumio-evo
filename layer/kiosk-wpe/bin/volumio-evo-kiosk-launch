#!/bin/sh
# volumio-evo-kiosk-launch - cage launcher (system-level setup).
#
# Unit file sets TTYPath=/dev/tty1, Wayland env, RuntimeDirectory=, and
# COG_PLATFORM_FDO_VIEW_FULLSCREEN=1. Preflight only probes DRM.
#
# This script resolves user settings (from overlay files + kiosk.toml),
# exports wlroots environment for cage, and execs cage with the session
# script as cage's single Wayland client.
#
# The OSK is NOT started here. It is a Wayland client and needs the cage
# Wayland socket to already exist, which is only true after cage has
# started. OSK startup therefore lives in volumio-evo-kiosk-session, which
# cage spawns as its child with WAYLAND_DISPLAY already set.
#
# Runtime config (overlays win over TOML):
#   - /etc/volumio-evo/kiosk.toml
#   - /var/lib/volumio-evo/settings/kiosk/*

set -eu

KIOSK_URL="${KIOSK_URL:-http://127.0.0.1/}"
KIOSK_TOML="${KIOSK_TOML:-/etc/volumio-evo/kiosk.toml}"
KIOSK_SETTINGS_DIR="${KIOSK_SETTINGS_DIR:-/var/lib/volumio-evo/settings/kiosk}"
KIOSK_OUTPUT="${KIOSK_OUTPUT:-}"
SESSION_BIN="/usr/local/bin/volumio-evo-kiosk-session"

log() {
  printf '[kiosk-launch] %s\n' "$*"
}

# ------------------------------ TOML read ------------------------------

# Minimal TOML accessor using python3 tomllib if available, else a sed-based
# flat-key reader. Supports only top-level string/bool scalars we need.
toml_get() {
  key="$1"
  default="$2"
  if [ ! -r "${KIOSK_TOML}" ]; then
    printf '%s' "${default}"
    return
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - "${KIOSK_TOML}" "${key}" "${default}" <<'PY' 2>/dev/null || printf '%s' "${default}"
import sys
try:
    import tomllib
except Exception:
    sys.exit(1)
path, key, default = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(path, "rb") as f:
        data = tomllib.load(f)
except Exception:
    print(default, end="")
    sys.exit(0)
val = data.get(key, default)
if isinstance(val, bool):
    print("true" if val else "false", end="")
else:
    print(str(val), end="")
PY
    return
  fi
  # Fallback parser (flat keys only, no sections).
  awk -v k="${key}" -v d="${default}" '
    /^[[:space:]]*#/ { next }
    /^\[/ { next }
    {
      line=$0
      sub(/#.*$/, "", line)
      n=index(line, "=")
      if (n == 0) next
      lhs=substr(line,1,n-1); rhs=substr(line,n+1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", lhs)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", rhs)
      gsub(/^"/, "", rhs); gsub(/"$/, "", rhs)
      gsub(/^'\''/, "", rhs); gsub(/'\''$/, "", rhs)
      if (lhs == k) { print rhs; exit }
    }
    END { if (!found) print d }
  ' "${KIOSK_TOML}"
}

# Overlay wins over TOML. Empty overlay -> TOML -> hard default.
resolve() {
  key_overlay="$1"
  key_toml="$2"
  default="$3"
  f="${KIOSK_SETTINGS_DIR}/${key_overlay}"
  if [ -r "${f}" ]; then
    v=$(head -1 "${f}" | tr -d '\r\n' || true)
    if [ -n "${v}" ]; then
      printf '%s' "${v}"
      return
    fi
  fi
  v=$(toml_get "${key_toml}" "${default}")
  printf '%s' "${v}"
}

OSK=$(resolve osk osk squeekboard)
CURSOR=$(resolve cursor cursor auto)
OSK_FORCE_SHOW=$(resolve osk_force_show osk_force_show false)
AUTO_ROTATE=$(resolve auto_rotate auto_rotate false)
XKB_LAYOUT=$(resolve xkb_layout xkb_layout us)
ROT_RAW=$(resolve rotation rotation 0)

# Rotation: overlay > TOML > 0.
case "${ROT_RAW}" in
  0)   CAGE_ROT=normal ;;
  90)  CAGE_ROT=90 ;;
  180) CAGE_ROT=180 ;;
  270) CAGE_ROT=270 ;;
  *)   CAGE_ROT=normal ;;
esac

# URL override via TOML.
URL_FROM_TOML=$(toml_get url "${KIOSK_URL}")
if [ -n "${URL_FROM_TOML}" ]; then
  KIOSK_URL="${URL_FROM_TOML}"
fi

log "url=${KIOSK_URL} output=${KIOSK_OUTPUT:-<first>} rotation=${CAGE_ROT} osk=${OSK} cursor=${CURSOR} auto_rotate=${AUTO_ROTATE}"

# ---------------------------- Cage environment ------------------------------

# Cage takes -s (allow switching) and -d (hide cursor) plus a command after
# `--`. We map CURSOR=hide -> -d. On CURSOR=show we leave the default.
CAGE_ARGS="-s"
case "${CURSOR}" in
  hide)
    # Cage 0.2.0 supports -d (no cursor). Older: fall back to transparent
    # XCURSOR_THEME; we do not ship one in P0.
    CAGE_ARGS="${CAGE_ARGS} -d"
    ;;
  show|auto|*) : ;;
esac

# Rotation via WLR env (wlroots reads this). Only set when non-normal so we
# do not override the compositor default on fresh installs.
export WLR_XKB_LAYOUT="${XKB_LAYOUT}"
if [ "${CAGE_ROT}" != "normal" ]; then
  if [ -n "${KIOSK_OUTPUT}" ]; then
    # Preferred form: per-output transform. wlroots key format:
    #   WLR_OUTPUT_<NAME_WITH_DASHES_REPLACED_BY_UNDERSCORES>_TRANSFORM
    canon=$(printf '%s' "${KIOSK_OUTPUT}" | tr '-' '_')
    varname="WLR_OUTPUT_${canon}_TRANSFORM"
    # POSIX sh has no `export "${var}=val"`. Use env.
    export "${varname}=${CAGE_ROT}" 2>/dev/null || eval "export ${varname}=${CAGE_ROT}"
  else
    export WLR_RENDER_NO_EXPLICIT_SYNC=1 2>/dev/null || true
    # Global fallback (older wlroots).
    export WLR_OUTPUT_TRANSFORM="${CAGE_ROT}"
  fi
fi

if [ -n "${KIOSK_OUTPUT}" ]; then
  export WLR_OUTPUTS="${KIOSK_OUTPUT}"
fi

# Pass resolved settings through to the session script. cage inherits the
# parent environment for its single client process, so these variables are
# visible to volumio-evo-kiosk-session when cage spawns it.
export KIOSK_URL
export OSK
export OSK_FORCE_SHOW

if [ ! -x "${SESSION_BIN}" ]; then
  log "ERROR: session helper missing at ${SESSION_BIN}"
  exit 1
fi

# Exec cage with the session script as cage's single Wayland client. The
# session script runs inside cage's Wayland environment and will start the
# OSK (after the Wayland socket exists) then exec cog. No --fullscreen
# flag on cog: that flag does not exist. Fullscreen is controlled by
# COG_PLATFORM_FDO_VIEW_FULLSCREEN=1 set in the unit Environment= block,
# and cage as a kiosk compositor fullscreens its single client anyway.
log "exec cage ${CAGE_ARGS} -- ${SESSION_BIN}"
exec cage ${CAGE_ARGS} -- "${SESSION_BIN}"
